# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Patterns without a leading "/" apply in every folder, including apps/core-api, apps/ai-api and apps/voice-api.

# dependencies (root and every app)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
/.next/
/out/
/build
apps/core-api/dist/
*.tsbuildinfo
next-env.d.ts

# testing
coverage/
.pytest_cache/
.nyc_output/

# python (ai-api, voice-api)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# env files: secrets stay local. The example file has placeholders only and is committed.
.env*
!.env.example

# keys and certificates
*.pem
*.key

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# editors and operating systems
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# vercel
.vercel

# local Claude Code settings (per machine)
.claude/settings.local.json
