{
  "name": "admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:backend": "npm --prefix apps/core-api run dev",
    "build:backend": "npm --prefix apps/core-api run build",
    "dev:ollama": "taskkill /IM \"ollama app.exe\" /IM ollama.exe /F >nul 2>&1 & ping -n 3 127.0.0.1 >nul & set OLLAMA_NUM_GPU=0&& ollama serve",
    "dev:voice":"cd apps/voice-api && .venv\\Scripts\\python -X utf8 -m uvicorn app.main:app --port 8050",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "lucide-react": "^1.66.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4"
  }
}
