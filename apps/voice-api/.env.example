# Voice & Message Assistant Backend settings. Copy to .env and fill in. Real environment variables override this file.

# Must equal SERVICE_SECRET_VOICE in the Core ERP's .env. Use a long random value in production.
SERVICE_SECRET_VOICE=change-me-to-a-long-random-secret
NODE_ENV=production

# Language model that writes answers: "ollama" (your own server) or "anthropic" (Claude).
ASSISTANT_LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# qwen2.5:7b for good quality; qwen2.5:3b is faster on a CPU-only machine.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=180
# OLLAMA_NUM_CTX=4096
# On a laptop with a small GPU, CPU only is faster:
# OLLAMA_NUM_GPU=0
# OLLAMA_NUM_THREAD=8
# OLLAMA_KEEP_ALIVE=30m

# Only for ASSISTANT_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_EFFORT=medium

# Meaning-based search: "ollama" (bge-m3 understands Bangla) or "voyage". Leave empty for word search only.
ASSISTANT_EMBED_PROVIDER=ollama
OLLAMA_EMBED_MODEL=bge-m3
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3.5

# Shared database login for call sessions and transcripts (role voice_service, created by the
# Core ERP when VOICE_DB_PASSWORD is set in its .env; Row Level Security limits it per institution).
VOICE_DATABASE_URL=postgresql://voice_service:change-me@localhost:5432/erp_db

# Speech on your own server: Whisper for speech to text, MMS voices for text to speech.
# VOICE_STT_MODEL=small            (English, and spotting the language)
# VOICE_STT_MODEL_BN=large-v3-turbo  (Bangla; "small" and "medium" cannot read Bangla)
# VOICE_CPU_THREADS=8
# VOICE_MAX_SECONDS=60
