# ==========================================
# MULTI-INSTITUTION ERP ENVIRONMENT CONFIG
# ==========================================

# Core ERP Backend
PORT=4000
NODE_ENV=development
ERP_DATABASE_URL=postgresql://erp_user:erp_secret@localhost:5432/erp_db
JWT_SECRET=super_secret_jwt_access_key_change_in_production_32char
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production
SERVICE_SECRET_AI=ai_service_internal_secret_key_9901
SERVICE_SECRET_VOICE=voice_service_internal_secret_key_8802

# AI Backend (FastAPI)
AI_PORT=8000
AI_DATABASE_URL=postgresql://ai_user:ai_secret@localhost:5433/ai_db
REDIS_URL=redis://localhost:6379/0
CORE_ERP_API_URL=http://localhost:4000/api/v1
OPENAI_API_KEY=your_openai_api_key_or_local_llm_key

# Voice Assistant Backend (FastAPI)
VOICE_PORT=8050
VOICE_DATABASE_URL=postgresql://voice_user:voice_secret@localhost:5434/voice_db
VOICE_SERVICE_SECRET=voice_service_internal_secret_key_8802
CORE_ERP_API_BASE=http://localhost:4000/api/v1

# Frontend (Next.js)
NEXT_PUBLIC_CORE_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_AI_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_VOICE_API_URL=http://localhost:8050/api/v1

# Hostel email (Core ERP Backend). Student mail goes to the address on each
# allocation. TO_EMAIL only receives admin alerts and test messages.
# EMAIL_PASS must be a Gmail App Password, not the account password.
EMAIL_USER=
EMAIL_PASS=
TO_EMAIL=

# Addresses used in payment links and the bKash callback. Use https in production.
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# Encrypts bKash credentials in the database. At least 32 random characters.
# Changing it makes saved credentials unreadable, so they must be entered again.
HOSTEL_SECRET_KEY=
# Real money stays blocked until this is true on the live server.
HOSTEL_ALLOW_BKASH_PRODUCTION=false

# Hostel rent reminders (Core ERP Backend)
# Used for SMS, and for email only when EMAIL_USER is not set.
# Each provider receives a POST with JSON: { channel, to, from, subject, text, html, reference }
# and a "Authorization: Bearer <key>" header. Leave a URL empty to turn that channel off;
# its messages are then logged as Skipped, never as Sent.
HOSTEL_EMAIL_API_URL=
HOSTEL_EMAIL_API_KEY=
HOSTEL_EMAIL_FROM=
HOSTEL_SMS_API_URL=
HOSTEL_SMS_API_KEY=
HOSTEL_SMS_FROM=
# How often billing and reminders run. Default 15.
HOSTEL_JOB_INTERVAL_MINUTES=15
